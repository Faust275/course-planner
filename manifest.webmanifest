{
  "name": "课表 Course Planner",
  "short_name": "课表",
  "description": "课程表、日程、四象限待办、日历、专注计时、记账、成绩与日记的一体化个人管理工具，数据全部存在本机。",
  "lang": "zh-CN",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7fb",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "今日课表",
      "short_name": "今日",
      "description": "打开就能看到今天上什么课、有哪些作业",
      "url": "./index.html#/today",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "写日记",
      "short_name": "日记",
      "description": "直接进到待办页的日记分页",
      "url": "./index.html#/diary",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "待办",
      "short_name": "待办",
      "description": "作业与待办清单",
      "url": "./index.html#/tasks",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
