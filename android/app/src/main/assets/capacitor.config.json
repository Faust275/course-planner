{
	"appId": "com.faust275.courseplanner",
	"appName": "Course Planner",
	"webDir": "dist",
	"loggingEnabled": false,
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"backgroundColor": "#f6f7fb",
			"showSpinner": false
		}
	}
}
