  "rules": {
    "no-undef": "error",
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-cond-assign": [
      "error",
      "except-parens"
    ],
    "no-constant-condition": [
      "error",
      {
        "checkLoops": false
      }
    ],
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-unreachable": "error"
  }
